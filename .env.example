# "development" or "production". In production, app/main.py refuses to
# start if JWT_SECRET_KEY is blank or FRONTEND_URL is still "*".
ENVIRONMENT=development

GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
GEMINI_CHAT_MODEL=gemini-2.5-flash
# models/text-embedding-004 was shut down by Google on 2026-01-14.
# gemini-embedding-001 is the current stable text-embedding model
# (gemini-embedding-2 is also available where supported). Changing this
# value requires rebuilding any existing FAISS/pgvector indexes, since
# they were built against a different embedding space.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_K=5

# "faiss" (single-instance, file-based) or "pgvector" (recommended for
# a real multi-instance deployment - see README).
VECTOR_STORE_BACKEND=faiss
FAISS_INDEX_BASE_DIR=data/vectorstore

PGVECTOR_COLLECTION_PREFIX=docpilot
# PGVECTOR_CONNECTION_STRING=postgresql+psycopg2://raguser:ragpassword@localhost:5432/ragdb

DOCUMENTS_BASE_DIR=data/documents
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

S3_BUCKET_NAME=your-s3-bucket-name

LOCAL_CACHE_DIR=data/cache

# Reject uploads larger than this before they're ever fully read into memory.
MAX_UPLOAD_SIZE_MB=20

APP_DB_URL=sqlite:///./data/app.db

# No default - the app refuses to start in production without this set.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Comma-separated list of allowed frontend origins, e.g.
# https://docpilot.example.com,https://app.docpilot.example.com
# "*" is only acceptable in development.
FRONTEND_URL=*

# Requests-per-window rate limits (slowapi syntax), applied to
# /auth/login, /auth/register, /upload and /chat.
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=20/minute
RATE_LIMIT_CHAT=30/minute
